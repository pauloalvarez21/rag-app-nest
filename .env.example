# Copia este archivo a .env y ajusta los valores según tu entorno.
#   cp .env.example .env

# --- Base de datos -----------------------------------------------------------
# Ruta del archivo SQLite (obligatoria). La carpeta se crea automáticamente.
DATABASE_PATH=./data/rag.db

# --- Almacenamiento ----------------------------------------------------------
# Carpeta donde se guardan los PDFs subidos (obligatoria).
UPLOAD_DIR=./uploads

# --- Chat (obligatorio) ------------------------------------------------------
# Cualquier proveedor compatible con la API de OpenAI. El ejemplo usa Groq.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=tu-clave-de-groq
OPENAI_MODEL=qwen/qwen3.8-27b

# --- Embeddings (obligatorio) ------------------------------------------------
# Proveedor propio, distinto del de chat: Groq no ofrece endpoint de embeddings.
# OpenRouter aloja openai/text-embedding-3-small, que da 1536 dimensiones
# (las que espera la tabla vec_chunks). No reutilices OPENAI_API_KEY aquí.
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=sk-or-v1-tu-clave-aqui
EMBEDDINGS_MODEL=openai/text-embedding-3-small

# --- Servidor ----------------------------------------------------------------
# Puerto del servidor HTTP (opcional, por defecto 3000).
PORT=3000
